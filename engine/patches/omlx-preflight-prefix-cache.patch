+def test_hot_prefix_cached_tokens_counts_shared_prefix():
+    """Route preflight credits the hot-cache prefix (agent loops resend a growing chat)."""
+    from types import SimpleNamespace
+
+    from omlx.engine.base import _hot_prefix_cached_tokens
+
+    class Paged:
+        def find_shared_prefix(self, tokens):
+            return [1, 2], ["h1", "h2"], tokens[8000:]
+
+    scheduler = SimpleNamespace(block_aware_cache=SimpleNamespace(paged_cache=Paged()))
+    assert _hot_prefix_cached_tokens(scheduler, list(range(8300))) == 7999
+    assert _hot_prefix_cached_tokens(SimpleNamespace(), list(range(10))) == 0
+    assert _hot_prefix_cached_tokens(scheduler, []) == 0
