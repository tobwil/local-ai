+def _hot_prefix_cached_tokens(scheduler: Any, tokens: Any) -> int:
+    """Tokens of ``tokens`` already held as a shared prefix in the hot paged cache.
+
+    Route preflight runs before a Request exists, so it used to charge every
+    prompt as a cold prefill. Agent loops resend a growing conversation whose
+    prefix is cached; charging the full length rejects requests that only need
+    a few hundred new tokens (seen on 24 GB Macs at ~10k tokens). This lookup is
+    read-only (no blocks are acquired); the scheduler's in-stream check still
+    re-validates with the real restore. One token is kept uncached, as the
+    scheduler needs at least one token to prefill.
+    """
+    try:
+        cache = getattr(scheduler, "block_aware_cache", None)
+        paged = getattr(cache, "paged_cache", None)
+        if paged is None or not tokens:
+            return 0
+        tokens = list(tokens)
+        _, _, remaining = paged.find_shared_prefix(tokens)
+        return max(0, len(tokens) - len(remaining) - 1)
+    except Exception:
+        return 0
+
+
 @dataclass
 class GenerationOutput:
